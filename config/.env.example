# ============================================================
# Nut-Shell Mapper - template de variaveis de ambiente
# Copie para config/.env e preencha com suas chaves reais.
# O arquivo .env NUNCA deve ser commitado.
# ============================================================

# --- VirusTotal (https://www.virustotal.com/gui/my-apikey) ---
VIRUSTOTAL_API_KEY=coloque_sua_chave_aqui
VIRUSTOTAL_RATE_LIMIT=4          # requisicoes por minuto (free tier = 4)

# --- Shodan (https://account.shodan.io/) ---
SHODAN_API_KEY=coloque_sua_chave_aqui

# --- abuse.ch: MalwareBazaar, URLhaus, ThreatFox e YARAify (https://auth.abuse.ch/) ---
# Uma chave so vale para os quatro.
MALWAREBAZAAR_API_KEY=

# --- Reputacao e inteligencia (todas opcionais) ---
ABUSEIPDB_API_KEY=         # https://www.abuseipdb.com/account/api
OTX_API_KEY=               # https://otx.alienvault.com/ (perfil -> OTX Key)
URLSCAN_API_KEY=           # https://urlscan.io/user/profile/
CENSYS_API_TOKEN=          # https://platform.censys.io/ (Personal Access Token)
HIBP_API_KEY=              # https://haveibeenpwned.com/API/Key (paga; sem ela, so o catalogo gratuito)
INTELX_API_KEY=            # https://intelx.io/account?tab=developer

# --- Caminhos ---
SAMPLES_DIR=data/samples
OUTPUT_DIR=output
MITRE_CACHE_DIR=data/mitre_cache

# --- Comportamento ---
# Se false, nenhuma chamada a API externa e feita (modo offline/dev)
ENABLE_ENRICHMENT=true
# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Timeout padrao para requisicoes HTTP (segundos)
HTTP_TIMEOUT=30
